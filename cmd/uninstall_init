#!/bin/bash

### 卸载前：停掉管理端与容器，避免「应用已删、进程还在跑」的残留。

LOG_FILE="${TRIM_PKGVAR}/info.log"
APP_DIR="${HERMES_APP_DIR:-/var/apps/${TRIM_APPNAME:-hermes-agent}}"
DEST_DIR="${TRIM_APPDEST:-${APP_DIR}/target}"
COMPOSE_FILE="${DEST_DIR}/docker/docker-compose.yaml"
PID_FILE="${TRIM_PKGVAR}/manager.pid"

log_msg() {
    printf '%s - [uninstall_init] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >>"${LOG_FILE}" 2>/dev/null || true
}

if [ -r "${PID_FILE}" ]; then
    pid="$(cat "${PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        log_msg "停止管理端进程 PID=${pid}"
        kill -TERM "${pid}" 2>/dev/null || true
        sleep 2
        kill -KILL "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
fi
rm -f "${DEST_DIR}/web.sock" 2>/dev/null || true

if command -v docker >/dev/null 2>&1; then
    if [ -f "${COMPOSE_FILE}" ]; then
        log_msg "停止并移除容器"
        timeout 180 docker compose -p hermes-agent -f "${COMPOSE_FILE}" down --remove-orphans >>"${LOG_FILE}" 2>&1 \
            || log_msg "compose down 未成功（忽略，继续卸载）"
    fi
    if [ -n "$(docker ps -aq -f "name=^hermes-agent$" 2>/dev/null)" ]; then
        log_msg "清理残留容器 hermes-agent"
        timeout 60 docker rm -f hermes-agent >>"${LOG_FILE}" 2>&1 || true
    fi
fi

exit 0
